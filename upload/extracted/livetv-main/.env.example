# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# STAR_IPTV_API_KEY: Provider API key for Xtream Masters / Star IPTV API v3.
STAR_IPTV_API_KEY="MY_STAR_IPTV_API_KEY"

# CLOUDFLARE_ACCOUNT_ID: Cloudflare Account ID for Workers and R2 storage
CLOUDFLARE_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"

# CLOUDFLARE_API_TOKEN: Cloudflare Bearer API Token
CLOUDFLARE_API_TOKEN="YOUR_CLOUDFLARE_API_TOKEN"

# CLOUDFLARE_R2_ACCESS_KEY_ID: S3-compatible R2 Access Key ID
CLOUDFLARE_R2_ACCESS_KEY_ID="YOUR_R2_ACCESS_KEY_ID"

# CLOUDFLARE_R2_SECRET_ACCESS_KEY: S3-compatible R2 Secret Access Key
CLOUDFLARE_R2_SECRET_ACCESS_KEY="YOUR_R2_SECRET_ACCESS_KEY"

# CLOUDFLARE_R2_ENDPOINT: S3-compatible R2 Endpoint
CLOUDFLARE_R2_ENDPOINT="https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com"

# IPTV Provider Node
GEOTV_HOST="https://your-authorized-provider.example"
GEOTV_USER="YOUR_IPTV_USERNAME"
GEOTV_PASS="YOUR_IPTV_PASSWORD"
