# ========================================================
# AETHER STREAM — PRIVATE PILOT / CLOSED-BETA CONFIGURATION
# Pre-SECP Company Registration Private Testing (3–5 Members)
# ========================================================
VITE_SUPABASE_URL=https://ujzvkwgrxtujpinkytbf.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=https://ujzvkwgrxtujpinkytbf.supabase.co
SUPABASE_ANON_KEY=

APP_URL=
NODE_ENV=development
PORT=3000

PRIVATE_MODE=true
MAX_PRIVATE_USERS=5
MAX_DEVICES_PER_USER=2
PUBLIC_REGISTRATION=false
PAYMENTS_ENABLED=false
COMMERCIAL_MODE=false

# ========================================================
# AUTHORIZED STAR IPTV CREDENTIALS VAULT
# Enter your actual Star IPTV details here or in Admin -> Star IPTV.
# Stored securely server-side only. NEVER exposed to frontend clients!
# ========================================================
STAR_IPTV_PROVIDER_NAME="Playbeat Star IPTV Reseller"
STAR_IPTV_SERVER_URL=
STAR_IPTV_USERNAME=
STAR_IPTV_PASSWORD=
STAR_IPTV_M3U_URL=
STAR_IPTV_EPG_URL=
STAR_IPTV_API_URL=
STAR_IPTV_API_KEY=
STAR_IPTV_RESELLER_ID=

# ========================================================
# SECURITY & AUTHENTICATION
# ========================================================
JWT_SECRET=
ADMIN_BOOTSTRAP_KEY=

# --------------------------------------------------------
# PILOT SEED ACCOUNT PASSWORDS (server-side only)
# The former hard-coded seed passwords ("admin123"/"member123")
# were publicly visible in the client bundle and git history and are
# RETIRED. Sign-in for the seeded pilot accounts now works ONLY when
# a password is provisioned here (minimum 8 characters). Unset => the
# seeded accounts accept no password (login 401).
#   PILOT_PASSWORD_ADMIN  -> Director console (admin@aetherstream.tv)
#   PILOT_PASSWORD_MEMBER -> seeded household member accounts
# Rotation: change the value and restart the server / redeploy.
# --------------------------------------------------------
PILOT_PASSWORD_ADMIN=
PILOT_PASSWORD_MEMBER=



# ========================================================
# DURABLE MEMBER LINE VAULT (optional — enables encrypted
# persistence of per-member Star IPTV line assignments to
# Supabase member_iptv_lines + cold-start hydration)
# Without these, the runtime (memory) store remains authoritative.
# ========================================================
# Supabase service_role secret key (Settings -> API). NEVER expose client-side.
SUPABASE_SERVICE_ROLE_KEY=
# Random string (e.g. openssl rand -hex 32); hashed to AES-256 key server-side.
LINE_VAULT_KEY=
